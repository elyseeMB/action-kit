{
  "compilerOptions": {
    "types": ["hot-hook/import-meta"],
    "baseUrl": ".",
    "paths": {
      "#config/*": ["./src/config/*"],
      "#router/*": ["./src/router/*"],
      "#controllers/*": ["./src/controllers/*"],
      "#actions/*": ["./src/actions/*"]
    },
    "experimentalDecorators": true,
    "target": "esnext",
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  }
}
