{
  "name": "express-test",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:server": "hot-runner --node-args=\"--import=tsx\" ./src/app.ts",
    "dev:vite": "vite",
    "dev": "concurrently -n server,vite -c blue,green \"npm:dev:server\" \"npm:dev:vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --import=tsx ./src/app.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "imports": {
    "#config/*": "./src/config/*.js",
    "#router/*": "./src/router/*.js",
    "#controllers/*": "./src/controllers/*.js",
    "#actions/*": "./src/actions/*.js"
  },
  "hotHook": {
    "boundaries": [
      "./actions/**/*.ts",
      "./router/**/*.ts"
    ],
    "restart": [
      ".env",
      "./config/**/*.ts"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "edge.js": "^6.5.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@hot-hook/runner": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "concurrently": "^9.1.0",
    "hot-hook": "^1.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-edgejs": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
